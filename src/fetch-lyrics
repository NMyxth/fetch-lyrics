#!/usr/bin/env python3
"""fetch-lyrics - batch-fetch .lrc lyrics for a folder of music.

Sources: LRCLIB (synced), lyrics.ovh (plain).
The output .lrc always has the SAME stem as the audio file, beside it, so
your local music/media player reads it. Alternate/cleaned titles are used for
the search only, never for the filename.

Usage:
    fetch-lyrics ~/Music
    fetch-lyrics ~/Music --force              # overwrite existing .lrc
    fetch-lyrics ~/Music --dry-run            # fetch, write nothing
    fetch-lyrics ~/Music --embed              # also write lyrics into tags
    fetch-lyrics ~/Music --jobs 4             # parallel workers
    fetch-lyrics --retry-misses               # only re-try missed files
    fetch-lyrics -i                           # interactive: search or browse
    fetch-lyrics --search "artist - title"    # print LRCLIB matches, no prompt
    fetch-lyrics ~/Music --sources LRCLIB,lyrics.ovh
    fetch-lyrics ~/Music --min-score 0.8
    fetch-lyrics ~/Music --m3u playlist.m3u   # also accept m3u path(s)

Reads no player config; writes .lrc files beside your audio (and, with
--embed, lyrics tags inside the audio file itself).
"""
from __future__ import annotations

import argparse
import concurrent.futures
import configparser
import difflib
import json
import os
import random
import re
import sys
import threading
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

try:
    from mutagen import File as MutagenFile
except ImportError:
    MutagenFile = None

AUDIO_EXT = {
    ".flac", ".mp3", ".m4a", ".m4b", ".ogg", ".opus",
    ".wav", ".wv", ".ape", ".aac", ".aiff",
}
AGENT = "fetch-lyrics/1.0 (+https://github.com/NMyxth/fetch-lyrics)"
VERSION = "1.0.3"
DEFAULT_SOURCES = "LRCLIB,lyrics.ovh"
DEFAULT_MIN_SCORE = 0.70
DEFAULT_DELAY = 0.6

NOISE_KEYS = [
    "official", "lyric", "video", "audio", "visualizer", "remaster", "topic",
    "lirik", "terjemahan", "indonesia", "music video", "prod.", "from the",
    "hd", "4k", "mv", "sped up", "slowed", "nightcore", "reverb",
]
BRACKETS = re.compile(r"[\(\[]\s*([^\)\]]*?)\s*[\)\]]")


# ---------------------------------------------------------------- helpers

class _Resp:
    """Minimal response object (status_code / headers / json)."""

    __slots__ = ("status_code", "headers", "_body")

    def __init__(self, status_code: int, headers: dict, body: bytes):
        self.status_code = status_code
        self.headers = headers
        self._body = body

    def json(self):
        return json.loads(self._body.decode("utf-8", "replace"))


def http_get(url: str, params: dict | None = None, timeout: int = 20, tries: int = 5):
    """GET with adaptive pacing and retry on 429/5xx. Returns a response or None."""
    if params:
        sep = "&" if "?" in url else "?"
        url = f"{url}{sep}{urllib.parse.urlencode(params)}"
    if not breaker_ok(url):
        return None
    for n in range(tries):
        pace_wait()
        req = urllib.request.Request(url, headers={"User-Agent": AGENT})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                pace_result(True)
                breaker_reset(url)
                return _Resp(r.status, dict(r.headers), r.read())
        except urllib.error.HTTPError as e:
            try:
                body = e.read()
            except Exception:  # noqa: BLE001
                body = b""
            if e.code == 200:
                pace_result(True)
                breaker_reset(url)
                return _Resp(200, dict(e.headers or {}), body)
            if e.code in (429, 502, 503, 504):
                pace_result(False)
                wait = min(30.0, float(2 ** n))  # 1, 2, 4, 8, 16
                ra = (e.headers or {}).get("Retry-After")
                if ra and str(ra).isdigit():
                    wait = max(wait, min(30.0, float(ra)))
                wait += random.uniform(0, 0.4)
                print(f"    {e.code}, backing off {wait:.1f}s (gap {pace_now():.1f}s)",
                      file=sys.stderr)
                time.sleep(wait)
                continue
            pace_result(True)
            breaker_reset(url)
            return _Resp(e.code, dict(e.headers or {}), body)
        except Exception:  # noqa: BLE001
            pace_result(False)
            time.sleep(min(8.0, float(2 ** n)) + random.uniform(0, 0.3))
    breaker_trip(url)
    return None


def clean(name: str) -> str:
    """Strip YouTube-style noise from an artist/title string."""
    s = name or ""
    s = BRACKETS.sub(
        lambda m: " " if any(k in m.group(1).lower() for k in NOISE_KEYS) else m.group(0),
        s,
    )
    s = re.sub(r"\s*[-\u2013]\s*(super )?(slowed|sped up|speed up|nightcore|reverb|remix)\b.*$",
               "", s, flags=re.I)
    s = re.sub(r"\b(official( music)? video|official audio|lyric video|lyrics?|visualizer|audio|mv|topic)\b",
               " ", s, flags=re.I)
    s = re.sub(r"\b(lirik|terjemahan|indonesia)\b", " ", s, flags=re.I)
    s = re.sub(r"[_\s]+", " ", s)
    return s.strip(" -\u2013|.,")


def norm(s: str) -> str:
    s = unicodedata.normalize("NFKD", s or "")
    s = "".join(c for c in s if not unicodedata.combining(c)).lower()
    s = re.sub(r"[^a-z0-9 ]+", " ", s)
    return re.sub(r"\s+", " ", s).strip()


def sim(a: str, b: str) -> float:
    a, b = norm(a), norm(b)
    if not a or not b:
        return 0.0
    return difflib.SequenceMatcher(None, a, b).ratio()


def artist_variants(artist: str) -> list[str]:
    """Split multi-artist tags ('A/B', 'A, B', 'A & B') into single names."""
    out: list[str] = []
    for part in re.split(r"[/,;&]", artist or ""):
        part = part.strip()
        if part and part not in out:
            out.append(part)
    return out


def read_tags(path: Path) -> tuple[str, str, str, int]:
    artist = title = album = ""
    dur = 0
    if MutagenFile is not None:
        try:
            m = MutagenFile(path, easy=True)
            if m is not None:
                artist = (m.get("artist") or [""])[0] or ""
                title = (m.get("title") or [""])[0] or ""
                album = (m.get("album") or [""])[0] or ""
                if getattr(m, "info", None) is not None:
                    dur = int(m.info.length or 0)
        except Exception:
            pass
    if not title:
        stem = path.stem
        if " - " in stem:
            a, t = stem.split(" - ", 1)
            artist = artist or a.strip()
            title = t.strip()
        else:
            title = stem.strip()
    # empty artist: pull "Artist - Title" out of the title
    if not artist and " - " in title:
        a, t = title.split(" - ", 1)
        artist, title = a.strip(), t.strip()
    return artist.strip(), title.strip(), album.strip(), dur


def existing_lrc(path: Path) -> Path | None:
    """Case-insensitive sibling .lrc with the same stem."""
    for f in path.parent.iterdir():
        if f.is_file() and f.stem == path.stem and f.suffix.lower() == ".lrc":
            return f
    return None


# ---------------------------------------------------------------- throttle

_THROTTLE = {"t": 0.0, "lock": threading.Lock()}

# Adaptive pacing: `--delay` is the floor. The gap grows on 429/503 and decays
# back down after a run of clean responses, so a healthy run stays quick and a
# rough one slows itself down instead of hammering the API.
_PACE = {"floor": DEFAULT_DELAY, "cur": DEFAULT_DELAY, "clean": 0, "lock": threading.Lock()}
PACE_MAX = 3.0
PACE_STEP = 0.5
PACE_DECAY = 0.1
PACE_CLEAN_RUN = 10


def throttle(delay: float) -> None:
    """Space out request starts across threads by `delay` seconds."""
    if delay <= 0:
        return
    with _THROTTLE["lock"]:
        now = time.monotonic()
        wait = _THROTTLE["t"] + delay - now
        if wait > 0:
            time.sleep(wait)
        _THROTTLE["t"] = time.monotonic()


def set_delay(floor: float) -> None:
    """Set the starting gap between HTTP requests (`--delay`)."""
    with _PACE["lock"]:
        _PACE["floor"] = max(0.0, floor)
        _PACE["cur"] = max(0.0, floor)
        _PACE["clean"] = 0


def pace_wait() -> None:
    """Hold every request `cur` seconds apart, wherever it came from."""
    with _PACE["lock"]:
        cur = _PACE["cur"]
    throttle(cur)


def pace_result(ok: bool) -> None:
    """Slow down after a rate-limit, speed back up after a clean run."""
    with _PACE["lock"]:
        if ok:
            _PACE["clean"] += 1
            if _PACE["clean"] >= PACE_CLEAN_RUN and _PACE["cur"] > _PACE["floor"]:
                _PACE["cur"] = max(_PACE["floor"], round(_PACE["cur"] - PACE_DECAY, 2))
                _PACE["clean"] = 0
        else:
            _PACE["clean"] = 0
            _PACE["cur"] = min(PACE_MAX, round(_PACE["cur"] + PACE_STEP, 2))


def pace_now() -> float:
    with _PACE["lock"]:
        return _PACE["cur"]


# Circuit breaker: when a host fails a whole request twice in a row, stop
# calling it for a minute instead of burning a backoff cycle on every track.
_BREAKER: dict[str, dict] = {}
BREAKER_AFTER = 2
BREAKER_COOL = 60.0


def breaker_host(url: str) -> str:
    return urllib.parse.urlsplit(url).netloc


def breaker_ok(url: str) -> bool:
    st = _BREAKER.get(breaker_host(url))
    return not (st and st["until"] > time.monotonic())


def breaker_reset(url: str) -> None:
    st = _BREAKER.get(breaker_host(url))
    if st:
        st["fails"] = 0


def breaker_trip(url: str) -> None:
    host = breaker_host(url)
    st = _BREAKER.setdefault(host, {"fails": 0, "until": 0.0})
    st["fails"] += 1
    if st["fails"] >= BREAKER_AFTER:
        st["until"] = time.monotonic() + BREAKER_COOL
        st["fails"] = 0
        print(f"    {host} keeps failing, skipping it for {BREAKER_COOL:.0f}s",
              file=sys.stderr)


# ---------------------------------------------------------------- embed

LRC_TS = re.compile(r"^\[(\d+):(\d+(?:[.:]\d+)?)\]\s*(.*)$")


def lrc_entries(synced: str) -> list[tuple[str, int]]:
    """Parse LRC into [(text, milliseconds)] for SYLT (sorted by time)."""
    out = []
    for line in (synced or "").splitlines():
        m = LRC_TS.match(line.strip())
        if not m:
            continue
        mm, ss, txt = m.group(1), m.group(2).replace(":", "."), m.group(3).strip()
        if not txt:
            continue
        ms = int(mm) * 60000 + int(round(float(ss) * 1000))
        out.append((txt, ms))
    out.sort(key=lambda e: e[1])
    return out


def embed_lyrics(path: Path, plain: str, synced: str) -> str:
    """Write lyrics into the audio file's tags. Returns ok/skip/none/err."""
    if MutagenFile is None:
        return "none"
    body = synced or plain
    if not body:
        return "skip"
    ext = path.suffix.lower()
    try:
        if ext == ".mp3":
            from mutagen.id3 import ID3, ID3NoHeaderError, SYLT, USLT
            try:
                tags = ID3(path)
            except ID3NoHeaderError:
                tags = ID3()
            tags.delall("SYLT")
            tags.delall("USLT")
            if synced:
                entries = lrc_entries(synced)
                if entries:
                    tags.add(SYLT(encoding=3, lang="eng", format=2, type=1, text=entries))
            tags.add(USLT(encoding=3, lang="eng", desc="", text=body))
            tags.save(path)
            return "ok"
        m = MutagenFile(path)
        if m is None or m.tags is None:
            return "skip"
        if ext in (".m4a", ".m4b", ".mp4", ".aac"):
            m["\xa9lyr"] = [body]
            m.save()
            return "ok"
        if hasattr(m.tags, "__setitem__"):  # vorbis comments (flac/ogg/opus)
            key = "LYRICS" if synced else "UNSYNCEDLYRICS"
            m.tags[key] = [body]
            m.save()
            return "ok"
    except Exception:
        return "err"
    return "skip"


# ---------------------------------------------------------------- sources

def src_lrclib_get(artist: str, title: str) -> tuple[str, str]:
    r = http_get("https://lrclib.net/api/get",
                 {"track_name": title, "artist_name": artist})
    if r is not None and r.status_code == 200:
        try:
            j = r.json()
            return j.get("plainLyrics") or "", j.get("syncedLyrics") or ""
        except Exception:
            return "", ""
    return "", ""


def src_lrclib_search(artist: str, title: str, album: str, dur: int,
                      min_score: float) -> tuple[str, str] | None:
    p = {}
    if title:
        p["track_name"] = title
    if artist:
        p["artist_name"] = artist
    if album:
        p["album_name"] = album
    if not p:
        return None
    r = http_get("https://lrclib.net/api/search", p)
    if r is None or r.status_code != 200:
        return None
    try:
        data = r.json()
    except Exception:
        return None
    best = None
    bs = -1.0
    bas = 0.0
    for c in data:
        a_s = sim(artist, c.get("artistName", ""))
        t_s = sim(title, c.get("trackName", ""))
        sc = t_s * 0.6 + a_s * 0.4
        cd = c.get("duration")
        if dur and cd and abs(dur - cd) <= 3:
            sc += 0.15
        if sc > bs:
            bs, bas, best = sc, a_s, c
    if best and bs >= min_score and (not artist or bas >= 0.35):
        return best.get("plainLyrics") or "", best.get("syncedLyrics") or ""
    return None


def src_lrclib_q(query: str, title: str, dur: int, min_score: float) -> tuple[str, str] | None:
    """Free-text LRCLIB search. Requires a strong title match to avoid wrong hits."""
    q = (query or "").strip()
    if not q:
        return None
    floor = max(min_score, 0.85)
    r = http_get("https://lrclib.net/api/search", {"q": q})
    if r is None or r.status_code != 200:
        return None
    try:
        data = r.json()
    except Exception:
        return None
    if not isinstance(data, list):
        return None
    best = None
    bs = -1.0
    for c in data:
        cd = c.get("duration")
        if dur and cd and abs(dur - cd) > 3:
            continue  # title match alone is not enough
        sc = sim(title, c.get("trackName", ""))
        if dur and cd and abs(dur - cd) <= 3:
            sc += 0.15
        if sc > bs:
            bs, best = sc, c
    if best and bs >= floor:
        return best.get("plainLyrics") or "", best.get("syncedLyrics") or ""
    return None


def src_ovh(artist: str, title: str) -> str:
    if not artist or not title:
        return ""
    r = http_get(f"https://api.lyrics.ovh/v1/{urllib.parse.quote(artist)}/{urllib.parse.quote(title)}")
    if r is not None and r.status_code == 200:
        try:
            return r.json().get("lyrics", "") or ""
        except Exception:
            return ""
    return ""


def find_lyrics(artist: str, title: str, album: str, dur: int,
                sources: list[str], min_score: float) -> tuple[str, str, str]:
    """Return (plain, synced, source_label)."""
    plain = synced = ""
    ca, ct = clean(artist), clean(title)

    if "LRCLIB" in sources:
        seen: list[str] = []
        for a in artist_variants(artist) + ([ca] if ca else []):
            if a and a not in seen:
                seen.append(a)
        for t in [title, ct]:
            if not t:
                continue
            for a in (seen or [""]):
                p, s = src_lrclib_get(a.strip(), t.strip())
                if p or s:
                    if s:
                        return p, s, "LRCLIB/get"
                    plain, synced = p, ""
                    break
            if plain or synced:
                break
        if not (plain or synced):
            for a in (seen or [""]):
                res = src_lrclib_search(a, ct, album, dur, min_score)
                if res:
                    plain, synced = res
                    if synced:
                        break
        if not (plain or synced):
            for a in seen:
                res = src_lrclib_q(f"{a} {ct}".strip() if ct else a, title or ct, dur, min_score)
                if res:
                    plain, synced = res
                    if synced:
                        break
        if not (plain or synced) and ct:
            res = src_lrclib_q(ct, title or ct, dur, min_score)
            if res:
                plain, synced = res

    if not (plain or synced) and "lyrics.ovh" in sources:
        ly = src_ovh(ca, ct)
        if ly:
            plain, synced = ly, ""

    label = "LRCLIB" if synced else ("LRCLIB" if plain else "")
    return plain, synced, label


# ---------------------------------------------------------------- input

def collect_files(roots: list[Path], m3us: list[Path], recursive: bool) -> list[Path]:
    out: list[Path] = []
    for root in roots:
        if root.is_file() and root.suffix.lower() in AUDIO_EXT:
            out.append(root)
        elif root.is_dir():
            it = root.rglob("*") if recursive else root.glob("*")
            out.extend(p for p in it if p.is_file() and p.suffix.lower() in AUDIO_EXT)
    for m in m3us:
        for line in m.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            p = Path(line)
            if not p.is_absolute():
                p = (m.parent / p).resolve()
            if p.is_file() and p.suffix.lower() in AUDIO_EXT:
                out.append(p)
    # dedupe, keep order
    seen = set()
    uniq = []
    for p in out:
        key = str(p)
        if key not in seen:
            seen.add(key)
            uniq.append(p)
    return sorted(uniq)


# ---------------------------------------------------------------- interactive

_COLOR = (
    sys.stdout.isatty()
    and (os.name != "nt" or bool(os.environ.get("WT_SESSION") or os.environ.get("TERM_PROGRAM")))
)


def _c(code: str, text: str) -> str:
    """ANSI colour when the terminal can take it, plain text otherwise."""
    return f"\033[{code}m{text}\033[0m" if _COLOR else str(text)


def _ask(prompt: str) -> str | None:
    """One prompt. None means Ctrl+C / Ctrl+D, so the caller backs out."""
    try:
        return input(prompt)
    except (EOFError, KeyboardInterrupt):
        print()
        return None


_BAD_CHARS = re.compile(r'[<>:"/\\|?*\x00-\x1f]')


def safe_name(s: str, limit: int = 120) -> str:
    s = _BAD_CHARS.sub("_", s or "")
    s = re.sub(r"\s+", " ", s).strip().strip(".")
    return s[:limit] or "lyrics"


def fmt_dur(sec) -> str:
    try:
        s = int(sec)
    except (TypeError, ValueError):
        return "--:--"
    return f"{s // 60}:{s % 60:02d}" if s > 0 else "--:--"


def kind_of(entry: dict) -> str:
    if entry.get("instrumental"):
        return "instrumental"
    if entry.get("syncedLyrics"):
        return "synced"
    if entry.get("plainLyrics"):
        return "plain"
    return "none"


def lrclib_search(query: str, limit: int = 10) -> list[dict]:
    r = http_get("https://lrclib.net/api/search", {"q": query})
    if r is None or r.status_code != 200:
        return []
    try:
        data = r.json()
    except Exception:
        return []
    if not isinstance(data, list):
        return []
    hits = [c for c in data if isinstance(c, dict)][:limit]
    q = norm(query)
    junk = re.compile(r"official|video|audio|lyrics|remix|cover|live|tribute", re.I)

    def rank(c: dict) -> tuple:
        text = norm(f"{c.get('artistName') or ''} {c.get('trackName') or ''}")
        score = sim(q, text)
        if junk.search(f"{c.get('artistName') or ''} {c.get('trackName') or ''}"):
            score -= 0.08
        if not (c.get("syncedLyrics") or c.get("plainLyrics")):
            score -= 0.20
        return (not bool(c.get("syncedLyrics")), -score)

    return sorted(hits, key=rank)


def print_result_row(i: int, c: dict) -> None:
    album = c.get("albumName") or ""
    row = (f"  {i:>2}  {c.get('artistName') or '?'} - {c.get('trackName') or '?'}"
           f"  [{fmt_dur(c.get('duration'))}] {kind_of(c)}")
    print(row + (f"  {_c('2', album)}" if album else ""))


def print_search(query: str) -> int:
    """--search: print matches and stop (no prompt)."""
    results = lrclib_search(query)
    if not results:
        print("no results", file=sys.stderr)
        return 1
    for i, c in enumerate(results, 1):
        print_result_row(i, c)
    return 0


def show_lyrics(text: str, n: int = 8) -> None:
    lines = [ln for ln in (text or "").splitlines() if ln.strip()]
    for ln in lines[:n]:
        print("   " + _c("2", ln))
    if len(lines) > n:
        print("   " + _c("2", f"... ({len(lines) - n} more lines)"))


def save_lrc(text: str, artist: str, title: str, out_dir: Path, force: bool,
             dry_run: bool) -> str:
    artist = (artist or "").strip()
    title = (title or "").strip()
    # LRCLIB titles often already carry the artist ("Adele - Hello"); don't double it.
    if artist and title.lower().startswith(artist.lower()):
        name = safe_name(title)
    elif artist and title:
        name = f"{safe_name(artist)} - {safe_name(title)}"
    else:
        name = safe_name(title or artist)
    target = out_dir / f"{name}.lrc"
    if dry_run:
        return f"dry-run: would write {target}"
    if target.exists() and not force:
        ans = _ask(f"  {target.name} exists, overwrite? [y/N]: ")
        if ans is None or ans.strip().lower() not in ("y", "yes"):
            return "kept the existing file"
    try:
        target.write_text(text.rstrip() + "\n", encoding="utf-8")
    except OSError as e:
        return f"error: {e}"
    return f"saved {target}"


def fetch_file(path: Path, sources: list[str], min_score: float,
               embed: bool, dry_run: bool) -> tuple[str, str, str]:
    """Fetch lyrics for one audio file. Returns (status, info, lrc name)."""
    artist, title, album, dur = read_tags(path)
    if not artist and not title:
        return "NO-META", "", ""
    plain, synced, _label = find_lyrics(artist, title, album, dur, sources, min_score)
    text = synced or plain
    if not text:
        return "MISS", (f"{artist} - {title}" if artist else title), ""
    target = path.with_suffix(".lrc")  # SAME stem as the audio file
    if not dry_run:
        target.write_text(text.rstrip() + "\n", encoding="utf-8")
        if embed:
            embed_lyrics(path, plain, synced)
    return "OK", "synced" if synced else "plain ", target.name


def fetch_batch(paths: list[Path], sources: list[str], min_score: float,
                embed: bool, dry_run: bool) -> None:
    ok = miss = 0
    total = len(paths)
    for i, p in enumerate(paths, 1):
        status, info, name = fetch_file(p, sources, min_score, embed, dry_run)
        if status == "OK":
            ok += 1
            print(f"  [{i}/{total}] OK {info} -> {name}")
        elif status == "NO-META":
            miss += 1
            print(f"  [{i}/{total}] NO-META  {p.name}")
        else:
            miss += 1
            print(f"  [{i}/{total}] MISS     {info}")
    print(f"  done: {ok} written, {miss} missed")


def parse_picks(s: str, n: int) -> list[int] | None:
    """'1,3-5' -> [1,3,4,5]. None when anything is out of range."""
    out: list[int] = []
    for part in re.split(r"[,\s]+", s.strip()):
        if not part:
            continue
        if "-" in part:
            a, _, b = part.partition("-")
            if not (a.isdigit() and b.isdigit()):
                return None
            out.extend(range(int(a), int(b) + 1))
        elif part.isdigit():
            out.append(int(part))
        else:
            return None
    if not out or any(i < 1 or i > n for i in out):
        return None
    return sorted(set(out))


def interactive_search(out_dir: Path, force: bool, dry_run: bool) -> None:
    while True:
        q = _ask(f"\n{_c('1', 'Search')} artist / title (empty = back): ")
        if q is None or not q.strip():
            return
        results = lrclib_search(q.strip())
        if not results:
            print("  no LRCLIB hits -- try 'artist - title'")
            continue
        print()
        for i, c in enumerate(results, 1):
            print_result_row(i, c)
        pick = _ask(f"  pick 1-{len(results)} (b = back, r = search again): ")
        if pick is None:
            return
        pick = pick.strip().lower()
        if pick in ("", "b", "back"):
            return
        if pick in ("r", "s", "search"):
            continue
        if not pick.isdigit() or not (1 <= int(pick) <= len(results)):
            print("  invalid choice")
            continue

        c = results[int(pick) - 1]
        synced = c.get("syncedLyrics") or ""
        plain = c.get("plainLyrics") or ""
        if not (synced or plain):
            print("  that entry has no lyrics text")
            continue
        print()
        show_lyrics(synced or plain)
        hint = ("  [s] save synced  [p] save plain  [b] back: " if (synced and plain)
                else "  [s] save  [b] back: ")
        act = _ask(hint)
        if act is None:
            return
        act = act.strip().lower()
        if act in ("b", "back"):
            continue
        text = plain if (act in ("p", "plain") and plain) else (synced or plain)
        msg = save_lrc(text, c.get("artistName") or "", c.get("trackName") or "",
                       out_dir, force, dry_run)
        print("  " + _c("32", msg))
        return


def interactive_folder(sources, min_score, embed, force: bool,
                       dry_run: bool, recursive: bool) -> None:
    raw = _ask(f"\n{_c('1', 'Folder')} [{Path.cwd()}]: ")
    if raw is None:
        return
    root = Path(raw.strip().strip('"') or ".").expanduser()
    if not root.is_dir():
        print(f"  not a folder: {root}")
        return
    files = collect_files([root], [], recursive)
    if not files:
        print("  no audio files found")
        return
    missing = [p for p in files if force or existing_lrc(p) is None]
    print(f"\n  {len(files)} audio file(s), {len(missing)} without .lrc\n")
    for i, p in enumerate(files, 1):
        if i > 200:
            print(f"  ... {len(files) - 200} more (still pickable by number)")
            break
        try:
            rel = p.relative_to(root)
        except ValueError:
            rel = p
        has = existing_lrc(p) is not None and not force
        mark = _c("32", "has .lrc") if has else _c("33", "missing")
        print(f"  {i:>3}  {rel}  {mark}")
    ans = _ask("\n  [a] fetch all missing   [1,3-5] pick   [b] back: ")
    if ans is None:
        return
    ans = ans.strip().lower()
    if ans in ("", "b", "back"):
        return
    if ans in ("a", "all"):
        chosen = missing
    else:
        picks = parse_picks(ans, len(files))
        if picks is None:
            print("  invalid selection")
            return
        chosen = [files[i - 1] for i in picks]
    if not chosen:
        print("  nothing to fetch")
        return
    print()
    fetch_batch(chosen, sources, min_score, embed, dry_run)


def interactive(sources, min_score, out_dir: Path, force: bool,
                dry_run: bool, embed: bool, recursive: bool) -> int:
    print(_c("1", "\nfetch-lyrics") + _c("2", "  interactive"))
    while True:
        print()
        print(_c("1", "  1") + "  Search a song")
        print(_c("1", "  2") + "  Browse a music folder")
        print(_c("1", "  3") + "  Quit")
        ans = _ask("\n> ")
        if ans is None:
            return 0
        ans = ans.strip().lower()
        if ans in ("1", "s", "search"):
            interactive_search(out_dir, force, dry_run)
        elif ans in ("2", "f", "folder"):
            interactive_folder(sources, min_score, embed, force, dry_run, recursive)
        elif ans in ("3", "q", "quit", "exit"):
            return 0
        elif ans:
            print("  pick 1, 2 or 3")


# ---------------------------------------------------------------- main

def load_config(path: Path) -> dict:
    """Read the optional INI config. Returns {} if absent or broken."""
    if not path.is_file():
        return {}
    cp = configparser.ConfigParser()
    try:
        cp.read(path)
    except Exception as e:  # noqa: BLE001
        print(f"warning: cannot read config {path}: {e}", file=sys.stderr)
        return {}
    if not cp.has_section("defaults"):
        return {}
    sec = cp["defaults"]
    out = {}
    if sec.get("sources"):
        out["sources"] = sec.get("sources")
    try:
        if sec.get("min_score") is not None:
            out["min_score"] = sec.getfloat("min_score")
        if sec.get("delay") is not None:
            out["delay"] = sec.getfloat("delay")
    except ValueError as e:
        print(f"warning: bad number in config: {e}", file=sys.stderr)
    return out


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="fetch-lyrics",
        description="Batch-fetch .lrc lyrics for a folder of music (LRCLIB / lyrics.ovh).",
    )
    ap.add_argument("paths", nargs="*", type=Path,
                    help="folders (or audio files) to scan")
    ap.add_argument("--m3u", action="append", default=[], type=Path,
                    help="also read audio paths from an .m3u playlist (repeatable)")
    ap.add_argument("--no-recursive", action="store_true",
                    help="only scan the top level of each folder")
    ap.add_argument("--force", action="store_true",
                    help="overwrite existing .lrc files")
    ap.add_argument("--dry-run", action="store_true",
                    help="fetch and report, write nothing")
    ap.add_argument("--sources", default=None,
                    help=f"comma list in order (default: {DEFAULT_SOURCES})")
    ap.add_argument("--min-score", type=float, default=None,
                    help=f"min match score for the search fallback (default: {DEFAULT_MIN_SCORE})")
    ap.add_argument("--delay", type=float, default=None,
                    help=f"starting gap between requests, in seconds; grows on "
                         f"429/503 (default: {DEFAULT_DELAY})")
    ap.add_argument("--config", type=Path, default=None,
                    help="config file (default: ~/.config/fetch-lyrics/config)")
    ap.add_argument("--version", action="version", version=f"fetch-lyrics {VERSION}")
    ap.add_argument("--no-config", action="store_true",
                    help="ignore the config file")
    ap.add_argument("--embed", action="store_true",
                    help="also write lyrics into the audio file tags (needs mutagen)")
    ap.add_argument("--jobs", type=int, default=1, metavar="N",
                    help="parallel fetch workers (default: 1)")
    ap.add_argument("--retry-misses", nargs="?", const="lyrics-misses.txt", default=None, metavar="FILE",
                    help="only re-try paths listed in FILE (default: lyrics-misses.txt)")
    ap.add_argument("-i", "--interactive", action="store_true",
                    help="interactive mode: search a song or browse a folder")
    ap.add_argument("--search", metavar="QUERY", default=None,
                    help="print LRCLIB matches for QUERY and exit (no prompt)")
    ap.add_argument("-o", "--out", type=Path, default=None, metavar="DIR",
                    help="interactive: folder for downloaded .lrc files (default: cwd)")
    args = ap.parse_args()

    conf = {}
    if not args.no_config:
        cpath = args.config if args.config else (Path.home() / ".config" / "fetch-lyrics" / "config")
        conf = load_config(cpath)

    sources_str = args.sources or conf.get("sources") or DEFAULT_SOURCES
    min_score = args.min_score if args.min_score is not None else conf.get("min_score", DEFAULT_MIN_SCORE)
    delay = args.delay if args.delay is not None else conf.get("delay", DEFAULT_DELAY)
    set_delay(delay)

    sources = [s.strip() for s in sources_str.split(",") if s.strip()]
    valid = {"LRCLIB", "lyrics.ovh"}
    bad = [s for s in sources if s not in valid]
    if bad:
        print(f"unknown source(s): {', '.join(bad)}. valid: {', '.join(sorted(valid))}", file=sys.stderr)
        return 2

    if args.search is not None:
        return print_search(args.search)

    # Bare `fetch-lyrics` on a real terminal opens the menu. Piped stdin keeps
    # the usage error, so scripts never hang waiting for a prompt.
    if (not args.paths and not args.m3u and not args.retry_misses
            and not args.interactive and sys.stdin.isatty()):
        args.interactive = True

    if args.interactive:
        out_dir = (args.out or Path.cwd()).expanduser()
        if not args.dry_run:
            try:
                out_dir.mkdir(parents=True, exist_ok=True)
            except OSError as e:
                print(f"cannot create {out_dir}: {e}", file=sys.stderr)
                return 2
        return interactive(sources, min_score, out_dir, args.force,
                           args.dry_run, args.embed, not args.no_recursive)

    if not args.paths and not args.m3u and not args.retry_misses:
        ap.error("give at least one path, --m3u FILE, or --retry-misses")

    roots = list(args.paths)
    for p in roots:
        if not p.exists():
            print(f"not found: {p}", file=sys.stderr)
            return 2

    if args.retry_misses:
        rf = Path(args.retry_misses)
        if not rf.is_file():
            print(f"miss file not found: {rf}", file=sys.stderr)
            return 2
        for line in rf.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            q = Path(line)
            if q.is_file() and q.suffix.lower() in AUDIO_EXT:
                roots.append(q)

    files = collect_files(roots, args.m3u, not args.no_recursive)
    todo = [p for p in files if args.force or existing_lrc(p) is None]

    embed_note = " embed=True" if args.embed else ""
    print(f"files={len(files)} to_fetch={len(todo)} "
          f"sources={','.join(sources)} jobs={args.jobs}{embed_note} dry_run={args.dry_run}")

    if args.embed and MutagenFile is None:
        print("warning: --embed needs mutagen (pip install mutagen); continuing without embedding.",
              file=sys.stderr)

    done = skipped = missed = 0
    misses: list[str] = []
    total = len(todo)
    seq = {"i": 0}

    def work(path: Path):
        status, info, name = fetch_file(path, sources, min_score,
                                        args.embed, args.dry_run)
        return status, path, info, name

    def handle(res) -> None:
        nonlocal done, missed
        status, path, info, name = res
        seq["i"] += 1
        i = seq["i"]
        if status == "OK":
            done += 1
            arrow = "" if args.dry_run else "-> "
            print(f"[{i}/{total}] OK {info} {arrow}{name}")
        elif status == "NO-META":
            missed += 1
            misses.append(str(path))
            print(f"[{i}/{total}] NO-META  {path.name}")
        else:
            missed += 1
            misses.append(str(path))
            print(f"[{i}/{total}] MISS     {info}")

    if args.jobs > 1 and total > 1:
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as ex:
            for res in ex.map(work, todo):
                handle(res)
    else:
        for path in todo:
            handle(work(path))

    print(f"SUMMARY written={done} skipped_existing={skipped} not_found={missed} total={total}")
    if misses:
        report = Path("lyrics-misses.txt")
        report.write_text("\n".join(misses) + "\n", encoding="utf-8")
        print(f"miss list -> {report.resolve()}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
